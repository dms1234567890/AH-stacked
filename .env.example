# Database
# Local PostgreSQL uses compose.yml and stays available while Docker is running.
POSTGRES_USER="prime"
POSTGRES_PASSWORD="change-this-local-password"
POSTGRES_DB="prime_academic_manager"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://prime:change-this-local-password@localhost:5432/prime_academic_manager?schema=public"
DATABASE_CONNECT_RETRIES=3
DATABASE_CONNECT_RETRY_DELAY_MS=1000

# For Neon, append connect_timeout=20&pool_timeout=20 to DATABASE_URL.
# For Supabase, replace DATABASE_URL with its PostgreSQL connection string.

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
GOOGLE_LOGIN_SHEET_ID="1_vUAFShQrvHRlJALfcnBCCZEZF7zHYGuulYV-kPifTI"
GOOGLE_CLASSES_STUDENTS_SHEET_ID="1DK4OpEdEDh2z_Ng9vIHbci41yBLSQ2m4ZXI7sqA7mJs"
GOOGLE_ADMISSIONS_SHEET_ID="1StEreMtS9_mbt4Np-T0J4WK5ILwDqyxmtqwxw8ZebOA"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
