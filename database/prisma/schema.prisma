// This is your Prisma schema file for Prime Academic Manager ERP
// PostgreSQL is the source of truth. Google Sheets is for reporting only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id            String          @id @default(uuid()) @db.Uuid
  username      String          @unique
  passwordHash  String          @map("password_hash")
  post          String          @default("ACADEMIC MANAGER") // Role description
  name          String
  email         String?
  mobile        String?
  role          UserRole        @default(STAFF)
  isActive      Boolean         @default(true) @map("is_active")
  lastLoginAt   DateTime?       @map("last_login_at")
  refreshToken  String?         @map("refresh_token")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  tasksGiven        Task[]      @relation("TaskGiver")
  tasksRated        TaskRating[]
  batchChanges      BatchChangeLog[]
  auditLogs         AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  TEACHER
}

// ============================================================
// EMPLOYEES & TEACHERS
// ============================================================

model Employee {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  employeeId    String          @unique @map("employee_id")
  email         String?
  department    String?
  designation   String?
  phone         String?
  isActive      Boolean         @default(true) @map("is_active")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  tasks         Task[]
  taskRatings   TaskRating[]

  @@map("employees")
}

model Teacher {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  teacherId     String          @unique @map("teacher_id")
  email         String?

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  classSchedules  ClassSchedule[]
  recurringSchedules    RecurringSchedule[]
  partialOriginal       PartialScheduleOverride[] @relation("OriginalTeacher")
  partialReplacement    PartialScheduleOverride[] @relation("ReplacementTeacher")
  teacherWorkTime       TeacherWorkTime?
  absences              TeacherAbsence[]
  mergedClasses         MergedClass[]
  sundayDuties          SundayDuty[]

  @@map("teachers")
}

// ============================================================
// SUBJECTS
// ============================================================

model Subject {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @map("name")
  code          String          @unique @map("code")
  isActive      Boolean         @default(true) @map("is_active")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  batchSubjects   BatchSubject[]
  classSchedules  ClassSchedule[]

  @@map("subjects")
}

// ============================================================
// BATCHES
// ============================================================

model Batch {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @unique
  classRoom     String?         @map("class_room")
  isActive      Boolean         @default(true) @map("is_active")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  subjects        BatchSubject[]
  students        Student[]
  classSchedules  ClassSchedule[]
  batchChanges    BatchChangeLog[]
  useDayWiseSchedule  Boolean  @default(false) @map("use_day_wise_schedule")
  recurringSchedules  RecurringSchedule[]
  partialOverrides    PartialScheduleOverride[]
  originalMerges      MergedClass[] @relation("OriginalBatch")
  mergedInto          MergedClass[] @relation("MergedBatch")

  @@map("batches")
}

model BatchSubject {
  id            String          @id @default(uuid()) @db.Uuid
  batchId       String          @map("batch_id") @db.Uuid
  subjectId     String          @map("subject_id") @db.Uuid

  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  batch         Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([batchId, subjectId])
  @@map("batch_subjects")
}

// ============================================================
// STUDENTS
// ============================================================

model Student {
  id                String          @id @default(uuid()) @db.Uuid
  studentId         String          @unique @map("student_id")
  startSession      String?         @map("start_session")
  endSession        String?         @map("end_session")
  dateOfApplication DateTime?       @map("date_of_application")
  studentName       String          @map("student_name")
  fatherName        String?         @map("father_name")
  dob               DateTime?       @map("dob")
  mobileNumbers     String?         @map("mobile_numbers")
  email             String?
  motherName        String?         @map("mother_name")
  category          String?
  fatherOccupation  String?         @map("father_occupation")
  defenceService    String?         @map("defence_service")
  jobDescription    String?         @map("job_description")
  class             String?
  presentSchool     String?         @map("present_school")
  batchId           String?         @map("batch_id") @db.Uuid
  additionalLanguage String?        @map("additional_language")
  program           String?
  status            StudentStatus   @default(ACTIVE)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  // Relations
  batch             Batch?          @relation(fields: [batchId], references: [id])
  batchChanges      BatchChangeLog[]

  @@index([batchId])
  @@index([studentName])
  @@index([studentId])
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  CANCELLED
  GRADUATED
}

model BatchChangeLog {
  id            String          @id @default(uuid()) @db.Uuid
  studentId     String          @map("student_id")
  studentName   String?         @map("student_name")
  previousBatch String?         @map("previous_batch")
  newBatch      String          @map("new_batch")
  changedById   String?         @map("changed_by_id") @db.Uuid
  changedByName String?         @map("changed_by_name")
  batchId       String?         @map("batch_id") @db.Uuid

  dateOfChange  DateTime        @default(now()) @map("date_of_change")

  // Relations
  student       Student?        @relation(fields: [studentId], references: [studentId])
  changedBy     User?           @relation(fields: [changedById], references: [id])
  batch         Batch?          @relation(fields: [batchId], references: [id])

  @@index([studentId])
  @@map("batch_change_logs")
}

// ============================================================
// ADMISSIONS
// ============================================================

model Admission {
  id                String          @id @default(uuid()) @db.Uuid
  studentId         String          @unique @map("student_id")
  startSession      String?         @map("start_session")
  endSession        String?         @map("end_session")
  dateOfApplication DateTime?       @map("date_of_application")
  studentName       String          @map("student_name")
  fatherName        String?         @map("father_name")
  dob               DateTime?       @map("dob")
  mobileNumbers     String?         @map("mobile_numbers")
  email             String?
  motherName        String?         @map("mother_name")
  category          String?
  fatherOccupation  String?         @map("father_occupation")
  defenceService    String?         @map("defence_service")
  jobDescription    String?         @map("job_description")
  class             String?
  presentSchool     String?         @map("present_school")
  program           String?
  status            AdmissionStatus @default(PENDING)
  enrolledAt        DateTime?       @map("enrolled_at")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  @@index([studentId])
  @@index([studentName])
  @@map("admissions")
}

enum AdmissionStatus {
  PENDING
  ENROLLED
  CANCELLED
  DUPLICATE
}

// ============================================================
// CLASS SCHEDULES
// ============================================================

model ClassSchedule {
  id            String          @id @default(uuid()) @db.Uuid
  date          DateTime
  batchId       String          @map("batch_id") @db.Uuid
  subjectId     String          @map("subject_id") @db.Uuid
  startTime     String?         @map("start_time")
  endTime       String?         @map("end_time")
  teacherId     String?         @map("teacher_id") @db.Uuid
  teacherName   String?         @map("teacher_name")
  teacherEmail  String?         @map("teacher_email")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  batch         Batch           @relation(fields: [batchId], references: [id])
  subject       Subject         @relation(fields: [subjectId], references: [id])
  teacher       Teacher?        @relation(fields: [teacherId], references: [id])

  @@index([date])
  @@index([batchId])
  @@map("class_schedules")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id            String          @id @default(uuid()) @db.Uuid
  token         String          @unique
  employeeId    String?         @map("employee_id")
  employeeName  String?         @map("employee_name")
  taskType      String?         @map("task_type")
  taskReason    String?         @map("task_reason")
  taskRole      String?         @map("task_role")
  taskDetail    String?         @map("task_detail")
  taskEndingDate DateTime?       @map("task_ending_date")
  giverId       String?         @map("giver_id") @db.Uuid
  status        TaskStatus      @default(PENDING)

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  // Relations
  giver         User?           @relation("TaskGiver", fields: [giverId], references: [id])
  employee      Employee?       @relation(fields: [employeeId], references: [employeeId])
  completions   TaskCompletion[]
  ratings       TaskRating[]

  @@index([employeeId])
  @@index([giverId])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  COMPLETED
  RATED
}

model TaskCompletion {
  id            String          @id @default(uuid()) @db.Uuid
  taskId        String          @map("task_id") @db.Uuid
  completedAt   DateTime        @default(now()) @map("completed_at")
  notes         String?

  // Relations
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_completions")
}

model TaskRating {
  id            String          @id @default(uuid()) @db.Uuid
  taskId        String          @map("task_id") @db.Uuid
  employeeId    String?         @map("employee_id") @db.Uuid
  rating        Int
  raterId       String?         @map("rater_id") @db.Uuid
  notes         String?

  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rater         User?           @relation(fields: [raterId], references: [id])
  employee      Employee?       @relation(fields: [employeeId], references: [id])

  @@unique([taskId])
  @@map("task_ratings")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id            String          @id @default(uuid()) @db.Uuid
  action        String
  entityType    String          @map("entity_type")
  entityId      String?         @map("entity_id")
  userId        String?         @map("user_id") @db.Uuid
  userName      String?         @map("user_name")
  oldValues     Json?           @map("old_values")
  newValues     Json?           @map("new_values")
  ipAddress     String?         @map("ip_address")

  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  user          User?           @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// SYNC TRACKING
// ============================================================

model SyncLog {
  id            String          @id @default(uuid()) @db.Uuid
  entityType    String          @map("entity_type")
  entityId      String          @map("entity_id")
  action        String          // INSERT, UPDATE, DELETE
  status        SyncStatus      @default(PENDING)
  retryCount    Int             @default(0) @map("retry_count")
  errorMessage  String?         @map("error_message")
  lastAttemptAt DateTime?       @map("last_attempt_at")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([entityType, entityId])
  @@map("sync_logs")
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ============================================================
// NEW CLASSES MANAGEMENT MODELS
// ============================================================

model RecurringSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  weekDay       String?  @map("week_day")  // Monday-Saturday or null for all days
  timeSlot      String   @map("time_slot") // e.g. "10:00-11:00"
  subject       String
  dutyType      String?  @map("duty_type")
  classRoom     String?  @map("class_room")
  teacherId     String?  @map("teacher_id") @db.Uuid
  teacherName   String?  @map("teacher_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  batch         Batch    @relation(fields: [batchId], references: [id])
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  @@index([batchId])
  @@index([teacherId])
  @@map("recurring_schedules")
}

model PartialScheduleOverride {
  id                    String   @id @default(uuid()) @db.Uuid
  date                  DateTime
  batchId               String   @map("batch_id") @db.Uuid
  timeSlot              String   @map("time_slot")
  subject               String
  dutyType              String?  @map("duty_type")
  classRoom             String?  @map("class_room")
  originalTeacherId     String?  @map("original_teacher_id") @db.Uuid
  replacementTeacherId  String?  @map("replacement_teacher_id") @db.Uuid
  reason                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  batch                 Batch    @relation(fields: [batchId], references: [id])
  originalTeacher       Teacher? @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  replacementTeacher    Teacher? @relation("ReplacementTeacher", fields: [replacementTeacherId], references: [id])
  @@index([date])
  @@index([batchId])
  @@map("partial_schedule_overrides")
}

model TeacherWorkTime {
  id            String   @id @default(uuid()) @db.Uuid
  teacherId     String   @unique @map("teacher_id") @db.Uuid
  teacherName   String?  @map("teacher_name")
  startTime     String   @map("start_time") // HH:mm
  endTime       String   @map("end_time")   // HH:mm
  startMinutes  Int      @map("start_minutes")
  endMinutes    Int      @map("end_minutes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
  @@map("teacher_work_times")
}

model TeacherAbsence {
  id            String   @id @default(uuid()) @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  teacherName   String?  @map("teacher_name")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  absenceType   String   @map("absence_type") // Full Day, Half Day, Late Entry, Specific Time Range
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
  @@index([teacherId])
  @@index([startDate, endDate])
  @@map("teacher_absences")
}

model MergedClass {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime
  originalBatchId String   @map("original_batch_id") @db.Uuid
  mergedBatchId   String   @map("merged_batch_id") @db.Uuid
  timeSlot        String   @map("time_slot")
  subject         String
  dutyType        String?  @map("duty_type")
  classRoom       String?  @map("class_room")
  teacherId       String?  @map("teacher_id") @db.Uuid
  teacherName     String?  @map("teacher_name")
  reason          String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  originalBatch   Batch    @relation("OriginalBatch", fields: [originalBatchId], references: [id])
  mergedBatch     Batch    @relation("MergedBatch", fields: [mergedBatchId], references: [id])
  teacher         Teacher? @relation(fields: [teacherId], references: [id])
  @@index([date])
  @@map("merged_classes")
}

model SundayDuty {
  id            String   @id @default(uuid()) @db.Uuid
  date          DateTime
  roomNumber    String   @map("room_number")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  teacherId     String?  @map("teacher_id") @db.Uuid
  teacherName   String?  @map("teacher_name")
  remarks       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  @@index([date])
  @@map("sunday_duties")
}

// ============================================================
// HEADS & SYLLABUS MANAGEMENT
// ============================================================

model HeadAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  assignmentType String   @map("assignment_type") // "Batch" or "Subject"
  targetName     String   @map("target_name")     // e.g. "TPC-01(2026)" or "ENGLISH"
  headName       String   @map("head_name")
  headEmployeeId String   @map("head_employee_id")
  assignedDate   DateTime @default(now()) @map("assigned_date")
  assignedBy     String?  @map("assigned_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([assignmentType])
  @@index([targetName])
  @@map("head_assignments")
}

model SyllabusModule {
  id                String   @id @default(uuid()) @db.Uuid
  subjectName       String   @map("subject_name")
  batchName         String   @map("batch_name")
  moduleNumber      String   @map("module_number") // e.g. "M001"
  moduleTitle       String   @map("module_title")  // e.g. "MODULE 1"
  chapterName       String   @map("chapter_name")
  moduleDescription String?  @map("module_description")
  dueDate           String?  @map("due_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([subjectName, batchName])
  @@map("syllabus_modules")
}

model ModuleProgress {
  id                 String   @id @default(uuid()) @db.Uuid
  recordId           String   @unique @map("record_id")
  timestamp          DateTime @default(now())
  teacherName        String   @map("teacher_name")
  teacherEmployeeId  String   @map("teacher_employee_id")
  batchName          String   @map("batch_name")
  subjectName        String   @map("subject_name")
  moduleNumber       String   @map("module_number")
  moduleTitle        String   @map("module_title")
  status             String   @default("Pending")
  reason             String?
  submittedAt        DateTime @default(now()) @map("submitted_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("module_progress")
}