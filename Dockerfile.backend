# =========================================================
# Multi-stage Dockerfile for NestJS Backend (@prime/backend)
# =========================================================

# Stage 1: Build Dependencies and Transpile TypeScript
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files and workspace configuration
COPY package*.json turbo.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY packages/shared/package*.json ./packages/shared/
COPY packages/types/package*.json ./packages/types/
COPY database/prisma ./database/prisma/

# Install dependencies
RUN npm ci

# Copy source files
COPY apps/backend ./apps/backend
COPY packages/shared ./packages/shared
COPY packages/types ./packages/types

# Generate Prisma Client
RUN npx prisma generate --schema=./database/prisma/schema.prisma

# Build production bundle
RUN npm run build --workspace=@prime/backend

# Stage 2: Production Runtime Image
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

# Copy package files and node_modules from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/package*.json ./apps/backend/
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/database/prisma ./database/prisma

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/v1/jobs/bootstrap || exit 1

CMD ["node", "apps/backend/dist/main.js"]
